# Copy these values into Streamlit Community Cloud -> App settings -> Secrets.
# Do NOT rename this file to secrets.toml and commit it.
GROQ_API_KEY = "gsk_..."
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_..."
GROQ_MODEL = "llama-3.3-70b-versatile"
MAX_AGENT_STEPS = "6"
STORE_CONVERSATIONS = "false"
ENABLE_ADMIN_DASHBOARD = "true"
ADMIN_PASSWORD = "set-a-password-before-public-demo"
